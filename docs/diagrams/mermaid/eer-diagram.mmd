    CATEGORIES ||--o{ CATEGORIES : parent_child
    CATEGORIES ||--o{ GEMS : categorizes

    GEMS ||--o| AUCTIONS : auction_listing
    GEMS ||--o{ TRANSACTIONS : sold_through
    GEMS ||--o| CERTIFICATES : verified_by
    GEMS ||--o{ WALLET_GEM_PURCHASES : purchased_as_store_item

    AUCTIONS ||--o{ BIDS : receives
    AUCTIONS ||--o{ WATCHLIST : tracked_by
    AUCTIONS ||--o{ TRANSACTIONS : creates_sale
    AUCTIONS ||--o{ WALLET_HOLDS : requires_deposit
    AUCTIONS ||--o{ SECOND_CHANCE_OFFERS : may_generate

    TRANSACTIONS ||--o{ REVIEWS : enables
