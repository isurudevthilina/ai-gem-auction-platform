NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Supabase
SUPABASE_URL=your_supabase_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ML service (FastAPI gem price predictor)
ML_SERVICE_URL=http://localhost:8000

# SMTP Configuration (for OTP emails)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Gmail:   You MUST use an App Password, NOT your Gmail password.
#          1. Enable 2-Step Verification at myaccount.google.com
#          2. Create App Password: myaccount.google.com/apppasswords
#          3. Use the 16-char code as SMTP_PASS
#
# Resend:  Easier for production. Sign up at resend.com, get API key.
#          SMTP_HOST=smtp.resend.com | SMTP_USER=resend | SMTP_PASS=your_api_key
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=your_email@gmail.com
